# 词达人鉴权（Fiddler 抓包 / Web 控制台扫码登录获取）
USERTOKEN=""
ABC=""
AUTH_V=""

# 自学任务课程
COURSE_ID="CET4_v2"
STUDY_GRADE="2"

# LLM（OpenAI 兼容接口，如 DeepSeek / Kimi / 豆包 / 本地 Ollama；留空则不调用 AI）
LLM_URL=""
LLM_KEY=""
LLM_MODEL="deepseek-chat"
LLM_MAX_TOKENS="1024"

# AI 策略: 1 = AI 优先答题; 0 = 规则优先(LLM 兜底)
AI_PRIORITY="1"

# 答题节奏(秒)与最大重刷轮数
DELAY_PER_QUESTION="2"
MAX_ROUNDS="10"

# 防卡保护: 单题超时(秒); USE_WORD_API=0 禁用查词接口(弱网提速)
QUESTION_TIMEOUT="60"
USE_WORD_API="1"

# OCR 读图: off/llm/tesseract/baidu（图片题干/选项识别）
OCR_MODE="off"
BAIDU_OCR_AK=""
BAIDU_OCR_SK=""
